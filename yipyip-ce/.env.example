# Server only. Never put an OpenAI key in the extension or a VITE_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REVIEW_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Streaming transcription model; partial text with client-side pause detection.
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
YIPYIP_PORT=8787
# Public URL bundled into the extension; use your hosted HTTPS origin for shared access.
VITE_AI_SERVER_URL=http://127.0.0.1:8787
# Local development defaults. For hosting, bind to 0.0.0.0 behind HTTPS and
# list allowed extension origins, e.g. chrome-extension://<your-extension-id>.
YIPYIP_HOST=127.0.0.1
YIPYIP_ALLOWED_ORIGINS=
